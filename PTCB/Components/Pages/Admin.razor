@page "/admin"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PTCB.Data
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject BankService Bank
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<PageTitle>Admin Panel</PageTitle>
<h1>Admin Panel</h1>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-danger" role="alert">@message</div>
}

<h3>Users</h3>
<table class="table">
    <thead>
    <tr>
        <th>Username</th>
        <th>Balance</th>
        <th>Admin</th>
        <th>Status</th>
        <th>Amount (Σ)</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var row in rows)
    {
        <tr>
            <td>@row.User.UserName</td>
            <td>@row.User.SumSumBalance.ToString("0.00") Σ</td>
            <td>@(row.IsAdmin ? "Yes" : "No")</td>
            <td>@(row.User.LockoutEnd is null ? "Active" : "Banned")</td>
            <td>
                <InputNumber @bind-Value="row.Amount" class="form-control" style="width: 8rem"/>
            </td>
            <td>
                <button class="btn btn-sm btn-success" @onclick="() => DepositAsync(row)">Deposit</button>
                <button class="btn btn-sm btn-warning" @onclick="() => WithdrawAsync(row)">Withdraw</button>
                <button class="btn btn-sm btn-secondary" @onclick="() => SetBalanceAsync(row)">Set</button>
                <button class="btn btn-sm btn-danger" @onclick="() => ToggleBanAsync(row)">
                    @(row.User.LockoutEnd is null ? "Ban" : "Unban")
                </button>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(row)">Delete</button>
                <button class="btn btn-sm btn-info" @onclick="() => ToggleAdminAsync(row)">
                    @(row.IsAdmin ? "Remove admin" : "Make admin")
                </button>
            </td>
        </tr>
    }
    </tbody>
</table>

<h3>All Transactions</h3>
@if (txs is null)
{
    <p><em>Loading...</em></p>
}
else if (txs.Count == 0)
{
    <p>No transactions yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Date</th>
            <th>User</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Description</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var t in txs)
        {
            <tr>
                <td>@t.Timestamp.ToLocalTime()</td>
                <td>@userNames.GetValueOrDefault(t.UserId, t.UserId)</td>
                <td>@t.Type</td>
                <td>@t.Amount.ToString("0.00") Σ</td>
                <td>@t.Description</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<UserRow> rows = new();
    private List<Transaction>? txs;
    private Dictionary<string, decimal> amounts = new();
    private Dictionary<string, string> userNames = new();
    private string? message;

    private sealed class UserRow
    {
        public decimal Amount;
        public ApplicationUser User { get; set; } = default!;
        public bool IsAdmin { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        rows.Clear();

        userNames.Clear();

        var users = await Db.Users.OrderBy(u => u.UserName).ToListAsync();
        foreach (var user in users)
        {
            rows.Add(new UserRow { User = user, IsAdmin = await UserManager.IsInRoleAsync(user, "Admin") });
           
            userNames[user.Id] = user.UserName ?? "?";
        }

        txs = await Bank.GetAllTransactionsAsync();
    }

    private async Task DepositAsync(UserRow row)
    {
        await RunActionAsync(() => Bank.DepositAsync(row.User.Id, row.Amount));
    }

    private async Task WithdrawAsync(UserRow row)
    {
        await RunActionAsync(() => Bank.WithdrawAsync(row.User.Id, row.Amount));
    }

    private async Task SetBalanceAsync(UserRow row)
    {
        await RunActionAsync(() => Bank.SetBalanceAsync(row.User.Id, (decimal)row.Amount));
    }

    private async Task ToggleBanAsync(UserRow row)
    {
        if (row.User.LockoutEnd is null)
        {
            await UserManager.SetLockoutEnabledAsync(row.User, true);
            await UserManager.SetLockoutEndDateAsync(row.User, DateTimeOffset.MaxValue);
        }
        else
        {
            await UserManager.SetLockoutEndDateAsync(row.User, null);
        }
        message = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(UserRow row)
    {
        await UserManager.DeleteAsync(row.User); // history stays in transactions.db
        await LoadAsync();
    }

    private async Task ToggleAdminAsync(UserRow row)
    {
        if (row.IsAdmin)
            await UserManager.RemoveFromRoleAsync(row.User, "Admin");
        else
            await UserManager.AddToRoleAsync(row.User, "Admin");
        await LoadAsync();
    }

    private async Task RunActionAsync(Func<Task<decimal>> action)
    {
        try
        {
            await action();
            message = null;
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        await LoadAsync();
    }
}