@page "/wallet"
@using Microsoft.AspNetCore.Authorization
@using PTCB.Data
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@rendermode InteractiveServer
@inject BankService Bank
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider Auth

<PageTitle>Wallet</PageTitle>

<div class="card mb-4">
    <div class="card-body">
        <div class="text-secondary small text-uppercase">Current Balance</div>
        <div class="fs-1 fw-bold">@balance Σ</div>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@message</div>
}

<div class="card mb-4">
    <div class="card-header">Transfer</div>
    <div class="card-body">
        <label class="form-label">To</label>
        <input type="text" class="form-control mb-2" placeholder="Search a username..."
               value="@searchTerm"
               @oninput="OnSearchChanged"/>
        @if (selected is not null)
        {
            <div class="input-group mb-2">
                <span class="form-control">@selected.UserName</span>
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSelection">X</button>
            </div>
        }
        @if (results is { Count: > 0 })
        {
            <ul class="list-group mb-2">
                @foreach (var r in results)
                {
                    <li class="list-group-item list-group-item-action" style="cursor: pointer" @onclick="() => SelectUser(r)">
                        <span class="fw-semibold">@r.UserName</span>
                        <span class="float-end text-secondary">@r.SumSumBalance.ToString("0.00") Σ</span>
                    </li>
                }
            </ul>
        }
        <label class="form-label">Amount (Σ)</label>
        <InputNumber class="form-control mb-3" @bind-Value="amount"/>
        <button class="btn btn-success w-100" @onclick="TransferAsync" disabled="@(selected is null || amount <= 0)">Transfer</button>
    </div>
</div>

@code {
    private decimal balance;
    private decimal amount;
    private string? message;
    private bool isError;
    private string? userId;
    private List<ApplicationUser> recipients = new();
    private List<ApplicationUser>? results;
    private string searchTerm = string.Empty;
    private ApplicationUser? selected;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (userId != null)
                balance = await Bank.GetBalanceAsync(userId);
        }
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        selected = null;
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            results = null;
            return;
        }
        if (recipients.Count == 0)
            await LoadRecipientsAsync();
        var term = searchTerm.Trim();
        results = recipients
            .Where(u => u.UserName != null && u.UserName.Contains(term, StringComparison.OrdinalIgnoreCase))
            .Take(8)
            .ToList();
    }

    private async Task LoadRecipientsAsync()
    {
        recipients = await Db.Users
            .Where(u => u.Id != userId)
            .OrderBy(u => u.UserName)
            .ToListAsync();
    }

    private void SelectUser(ApplicationUser user)
    {
        selected = user;
        searchTerm = user.UserName ?? string.Empty;
        results = null;
    }

    private void ClearSelection()
    {
        selected = null;
        searchTerm = string.Empty;
        results = null;
    }

    private async Task TransferAsync()
    {
        try
        {
            await Bank.TransferAsync(userId!, selected!.Id, amount);
            balance = await Bank.GetBalanceAsync(userId!);
            amount = 0;
            ClearSelection();
            SetMessage($"Transferred successfully. New balance: {balance} Σ");
        }
        catch (Exception ex)
        {
            SetError(ex.Message);
        }
    }

    private void SetMessage(string msg)
    {
        message = msg;
        isError = false;
    }

    private void SetError(string msg)
    {
        message = msg;
        isError = true;
    }
}